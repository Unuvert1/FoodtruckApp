# Copy to .env.local and fill in. .env.local is gitignored: never commit real keys.

# ── Database: Supabase (supabase.com) → your project → Connect ──────────────
# "Transaction pooler" string (port 6543). Used by the running app.
DATABASE_URL=
# "Session pooler" string (port 5432). Used by `npx prisma migrate dev` and the seed.
DIRECT_URL=

# ── Login: Clerk (clerk.com) → your application → API keys ─────────────────
# Left blank in development, Clerk runs in "keyless" mode with temporary keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Email: Resend (resend.com) → API Keys. Optional ─────────────────────────
# Blank = new-order emails are printed to the terminal instead of sent.
RESEND_API_KEY=
# Blank = Resend's test sender, which only delivers to your own Resend address.
EMAIL_FROM=

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# "true" shows the "Manage the demo truck" button outside development (e.g. a class demo on Vercel).
ALLOW_DEMO_TRUCK_JOIN=

# ── Later (Stream C / image uploads) ────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BLOB_READ_WRITE_TOKEN=
