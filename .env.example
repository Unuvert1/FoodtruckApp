# Copy to .env.local and fill in. .env.local is gitignored: never commit real keys.

# ── Database: Supabase (supabase.com) → your project → Connect ──────────────
# Replace [YOUR-PASSWORD] including the brackets: ...:MyPass123@... not ...:[MyPass123]@...
# "Transaction pooler" string (port 6543). Used by the running app.
DATABASE_URL=
# "Session pooler" string (port 5432). Used by `npx prisma migrate dev` and the seed.
# Not the "Direct connection" string: that one is IPv6-only and fails on most networks.
# Easiest: copy DATABASE_URL and change 6543 to 5432.
DIRECT_URL=

# ── Login: Clerk (clerk.com) → your application → API keys ─────────────────
# Left blank in development, Clerk runs in "keyless" mode with temporary keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Email: Resend (resend.com) → API Keys. Optional ─────────────────────────
# Blank = new-order emails are printed to the terminal instead of sent.
RESEND_API_KEY=
# Blank = Resend's test sender, which only delivers to your own Resend address.
EMAIL_FROM=

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# "true" shows the "Manage the demo truck" button outside development (e.g. a class demo on Vercel).
ALLOW_DEMO_TRUCK_JOIN=
# "true" skips login entirely: /dashboard opens as the demo truck's owner. Development only;
# ignored in production builds. Remove it to use Clerk login again.
DEV_AUTH_BYPASS=

# ── Payments: Stripe (stripe.com → Developers → API keys). Test mode keys only ──
# Blank = no payment page: orders are marked paid straight away and nobody is charged (fine for local development).
STRIPE_SECRET_KEY=
# The webhook is how an order becomes "paid". Locally: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# prints a whsec_... secret. On Vercel: Stripe dashboard → Webhooks → add <your address>/api/webhooks/stripe
# for checkout.session.completed and checkout.session.expired, then copy its signing secret here.
STRIPE_WEBHOOK_SECRET=

# ── Later (image uploads) ───────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Cron ────────────────────────────────────────────────────────────────────
# Shared secret for /api/cron/sweep, which finishes READY orders nobody closed.
# Vercel sends it as `Authorization: Bearer <value>` when set on the project.
# Blank = the route stays closed. Any long random string will do.
CRON_SECRET=
