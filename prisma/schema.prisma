// FoodtruckApp schema. See CLAUDE.md for the rules this encodes:
// money is integer cents, rates are basis points, timestamps are UTC, every
// tenant-scoped row carries truckId, menu items are soft-deleted, and order
// line items are price snapshots.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  STAFF
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
  LIVE
  ENDED
  CANCELLED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  ACCEPTED
  PREPARING
  READY
  PICKED_UP
  CANCELLED
  REFUNDED
}

enum OrderSource {
  WEB
  SMS
  API
}

model Truck {
  id                   String  @id @default(cuid())
  slug                 String  @unique
  name                 String
  tagline              String  @default("")
  timezone             String // IANA zone, e.g. "America/Chicago"
  logoUrl              String?
  brandColor           String  @default("#22603F")
  brandColorForeground String  @default("#FFFFFF")
  heroImageUrl         String?
  stripeAccountId      String? @unique
  stripeOnboarded      Boolean @default(false)
  taxRateBps           Int     @default(0)
  platformFeeBps       Int     @default(250)
  customDomain         String? @unique
  notificationEmail    String? // where new-order emails go

  // Defaults a new Service starts from. Changing these never touches a
  // Service that already exists.
  defaultSlotMinutes          Int @default(15)
  defaultOrdersPerSlot        Int @default(4)
  orderingOpensHoursBefore    Int @default(24)
  orderingClosesMinutesBefore Int @default(15)
  slotLeadMinutes             Int @default(10) // how soon a customer can book a slot

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  locations   Location[]
  services    Service[]
  menus       Menu[]
  menuItems   MenuItem[]
  dishPhotos  DishPhoto[]
  orders      Order[]
}

// The tenancy boundary. Clerk only supplies the user's identity.
model Membership {
  id          String         @id @default(cuid())
  truckId     String
  clerkUserId String
  role        MembershipRole @default(OWNER)
  createdAt   DateTime       @default(now())

  truck Truck @relation(fields: [truckId], references: [id], onDelete: Cascade)

  @@unique([truckId, clerkUserId])
  @@index([clerkUserId])
}

model Location {
  id              String    @id @default(cuid())
  truckId         String
  name            String
  addressLine     String
  city            String
  region          String    @default("") // state/province
  postcode        String    @default("")
  lat             Float? // null when neither a geocoder nor a pasted map link gave coordinates
  lng             Float?
  notes           String? // parking note, shown to customers
  // Where the coordinates came from: "geoapify" | "photon" | "manual".
  provider        String    @default("manual")
  providerPlaceId String? // the provider's opaque id; indexed for "you already have this spot", never unique
  lastUsedAt      DateTime? // bumped when a Service is scheduled here; orders "your spots"
  archivedAt      DateTime? // soft delete: a Service may reference this spot

  truck    Truck     @relation(fields: [truckId], references: [id], onDelete: Cascade)
  services Service[]

  @@index([truckId])
  @@index([truckId, provider, providerPlaceId])
}

// One truck, at one location, from one time to another.
model Service {
  id               String        @id @default(cuid())
  truckId          String
  locationId       String
  menuId           String
  startsAt         DateTime
  endsAt           DateTime
  orderingOpensAt  DateTime
  orderingClosesAt DateTime
  slotMinutes      Int
  ordersPerSlot    Int
  status           ServiceStatus @default(DRAFT)
  orderCount       Int           @default(0) // incremented atomically to hand out order numbers
  publicNote       String        @default("") // one-off note for this stop only ("cash only today")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  truck       Truck        @relation(fields: [truckId], references: [id], onDelete: Cascade)
  location    Location     @relation(fields: [locationId], references: [id])
  menu        Menu         @relation(fields: [menuId], references: [id])
  pickupSlots PickupSlot[]
  orders      Order[]

  @@index([truckId, startsAt])
}

// Real rows, generated when a Service is published.
model PickupSlot {
  id          String   @id @default(cuid())
  serviceId   String
  startsAt    DateTime
  capacity    Int
  bookedCount Int      @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@unique([serviceId, startsAt])
}

model Menu {
  id        String  @id @default(cuid())
  truckId   String
  name      String
  isDefault Boolean @default(false)

  truck    Truck         @relation(fields: [truckId], references: [id], onDelete: Cascade)
  sections MenuSection[]
  services Service[]

  @@index([truckId])
}

model MenuSection {
  id        String @id @default(cuid())
  menuId    String
  name      String
  sortOrder Int    @default(0)

  menu  Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items MenuItem[]

  @@index([menuId])
}

model MenuItem {
  id          String    @id @default(cuid())
  truckId     String
  sectionId   String
  name        String
  description String    @default("")
  priceCents  Int
  imageUrl    String?
  isAvailable Boolean   @default(true)
  archivedAt  DateTime? // soft delete: never hard-delete an item an order may reference
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  truck          Truck           @relation(fields: [truckId], references: [id], onDelete: Cascade)
  section        MenuSection     @relation(fields: [sectionId], references: [id])
  modifierGroups ModifierGroup[]
  orderLineItems OrderLineItem[]

  @@index([truckId])
  @@index([sectionId])
}

/// A dish photo, stored in the database and served by /api/photos/[id].
/// Images are downscaled in the browser before upload, so rows stay small.
/// Swapping to object storage later means writing a different URL into
/// MenuItem.imageUrl — nothing else here changes.
model DishPhoto {
  id          String   @id @default(cuid())
  truckId     String
  contentType String
  width       Int
  height      Int
  bytes       Bytes
  createdAt   DateTime @default(now())

  truck Truck @relation(fields: [truckId], references: [id], onDelete: Cascade)

  @@index([truckId])
}

model ModifierGroup {
  id         String  @id @default(cuid())
  menuItemId String
  name       String
  minSelect  Int     @default(0)
  maxSelect  Int     @default(1)
  required   Boolean @default(false)
  sortOrder  Int     @default(0)

  menuItem MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  ModifierOption[]

  @@index([menuItemId])
}

model ModifierOption {
  id              String  @id @default(cuid())
  groupId         String
  name            String
  priceDeltaCents Int     @default(0)
  isAvailable     Boolean @default(true)
  sortOrder       Int     @default(0)

  group ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model Order {
  id                      String      @id @default(cuid())
  truckId                 String
  serviceId               String
  pickupSlotId            String
  orderNumber             String // "A07": short, for calling out at the window
  customerName            String
  customerPhone           String
  customerEmail           String?
  subtotalCents           Int
  taxCents                Int
  tipCents                Int
  platformFeeCents        Int
  totalCents              Int
  status                  OrderStatus @default(PENDING_PAYMENT)
  stripeCheckoutSessionId String?     @unique
  stripePaymentIntentId   String?     @unique
  placedAt                DateTime    @default(now())
  readyAt                 DateTime?
  pickedUpAt              DateTime?
  acceptedAt              DateTime? // set when the vendor taps Accept (PAID → PREPARING)
  autoCompletedAt         DateTime? // set by the 30-minute READY sweep, not by a human tap
  refundedCents           Int         @default(0) // sum of voided line items; no money has moved yet
  source                  OrderSource @default(WEB)
  updatedAt               DateTime    @updatedAt

  truck      Truck           @relation(fields: [truckId], references: [id], onDelete: Cascade)
  service    Service         @relation(fields: [serviceId], references: [id])
  pickupSlot PickupSlot      @relation(fields: [pickupSlotId], references: [id])
  lineItems  OrderLineItem[]

  @@unique([serviceId, orderNumber])
  @@index([truckId, status])
  @@index([status, placedAt]) // the unpaid-order sweep
  @@index([status, readyAt]) // the 30-minute auto-complete sweep
}

// A snapshot of what was bought, at the price paid. Never re-join to the live menu.
model OrderLineItem {
  id                String  @id @default(cuid())
  orderId           String
  menuItemId        String?
  nameSnapshot      String
  unitPriceCents    Int
  quantity          Int
  modifiersSnapshot Json // [{ group, name, priceDeltaCents }]
  lineTotalCents    Int
  voidedAt          DateTime? // the vendor removed this line after the fact
  voidedReason      String? // "SOLD_OUT" | "CUSTOMER_REQUEST" | "MISTAKE"
  voidedCents       Int       @default(0) // refund owed for this line, excl. tax

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// Stripe webhook idempotency guard: insert before processing.
model WebhookEvent {
  id            String    @id @default(cuid())
  stripeEventId String    @unique
  type          String
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
}
